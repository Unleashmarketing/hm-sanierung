  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Was kostet eine Komplettsanierung?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Typischerweise 800–1.500 € pro m² Wohnfläche, je nach Substanz, Materialwahl und Ausstattung. Eine 80 m² Wohnung liegt im Bereich 64.000–120.000 €. Den exakten Festpreis erhalten Sie nach der kostenlosen Vor-Ort-Begehung."
        }
      },
      {
        "@type": "Question",
        "name": "Wie schnell kann begonnen werden?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Der Vor-Ort-Termin ist binnen 48 Stunden möglich. Nach Auftragsannahme starten wir in 4–8 Wochen, je nach Projektgröße. Bei Notfällen (Wasserschaden) oft innerhalb einer Woche."
        }
      },
      {
        "@type": "Question",
        "name": "Übernehmen Sie alle Gewerke selbst?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja — Sanitär, Elektrik, Trockenbau, Boden, Maler, Fliesen und Entrümpelung machen wir mit unseren 45 Mitarbeitern. Nur bei speziellen Anforderungen arbeiten wir mit langjährigen Partnern."
        }
      },
      {
        "@type": "Question",
        "name": "Gibt es einen Festpreis oder Abrechnung nach Aufwand?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ausschließlich Festpreise, schriftlich nach Vor-Ort-Begehung. Verbindlich — auch wenn die Arbeit länger dauert. Nur bei nachträglichen Änderungswünschen vereinbaren wir gesondert."
        }
      },
      {
        "@type": "Question",
        "name": "Können wir während der Sanierung wohnen bleiben?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Bei Badsanierung oder Malerarbeiten oft möglich. Bei Kernsanierung empfehlen wir den Auszug für 3–8 Wochen. Das besprechen wir ehrlich im Vor-Ort-Termin."
        }
      },
      {
        "@type": "Question",
        "name": "Übernehmen Sie auch nur Teilleistungen?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Selbstverständlich — einzelne Gewerke wie nur die Bodenverlegung oder nur die Malerarbeiten."
        }
      },
      {
        "@type": "Question",
        "name": "Wie wickeln Sie Versicherungsschäden ab?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Bei Wasser- oder Brandschäden übernehmen wir die komplette Abwicklung mit Ihrer Versicherung: Schadensaufnahme, Kostenvoranschlag, direkte Abrechnung."
        }
      },
      {
        "@type": "Question",
        "name": "Welche Förderungen gibt es?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "KfW 261/461 für energetische Sanierung bis 75.000 € Kredit. BAFA für Heizungstausch bis 70 %. KfW 455-B für barrierefreien Umbau. Wir wickeln Antrag und Nachweise auf Wunsch komplett ab."
        }
      },
      {
        "@type": "Question",
        "name": "In welchen Städten und Regionen ist HM Sanierung tätig?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Wir sind in der gesamten Metropolregion Rhein-Neckar, in der Vorderpfalz und im Raum Heilbronn tätig. Dazu gehören unter anderem Heidelberg, Mannheim, Ludwigshafen, Frankenthal, Neustadt an der Weinstraße, Worms, Leimen, Schwetzingen, Weinheim, Sinsheim, Walldorf und Wiesloch. Fragen Sie uns auch gerne an, wenn Ihr Ort nicht aufgeführt ist."
        }
      }
    ]
